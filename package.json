{
  "name": "webapplens",
  "version": "0.2.0",
  "description": "Claude Code skill + agents for researching web applications: safe crawling, screenshots, evidence-tagged documentation.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "doctor": "node skills/webapp-research/scripts/cli.mjs doctor",
    "demo": "node scripts/run-demo.mjs",
    "postinstall": "node -e \"console.log('Next: npx playwright install chromium')\"",
    "viewer": "node skills/webapp-research/scripts/cli.mjs viewer",
    "install-skill": "node scripts/install.mjs",
    "sync-plugin": "node scripts/sync-plugin.mjs"
  },
  "dependencies": {
    "playwright": "~1.64.1"
  },
  "keywords": [
    "claude-code",
    "skill",
    "playwright",
    "reverse-engineering",
    "documentation",
    "crawler"
  ],
  "bin": {
    "webapplens": "bin/webapplens.mjs"
  },
  "files": [
    ".claude-plugin",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "assets",
    "bin",
    "commands",
    "docs",
    "hooks",
    "scripts/install.mjs",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-username>/webapplens.git"
  },
  "author": {
    "name": "Raheel Ahmad",
    "url": "https://artflow.pk"
  }
}
